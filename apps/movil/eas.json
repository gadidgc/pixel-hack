{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "default"
      },
      "env": {
        "SIN_TIEMPO_DE_USO": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "interno": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "default"
      },
      "env": {
        "SIN_TIEMPO_DE_USO": "1"
      }
    },
    "capturas": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "SIN_TIEMPO_DE_USO": "1",
        "EXPO_PUBLIC_URL_ALERTAS": "ninguno",
        "EXPO_PUBLIC_MODO_CAPTURAS": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826638823"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-servicio.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
