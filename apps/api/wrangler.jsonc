// Backend + web de Vigía en una sola URL (Cloudflare Workers + D1).
// Secretos (nunca en el repo): `npx wrangler secret put ZAVU_API_KEY` y, si hay plantilla de WhatsApp
// aprobada, `npx wrangler secret put ZAVU_PLANTILLA_ALERTA`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alerta-arrebato",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../movil/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alerta-arrebato",
      "database_id": "f163087c-76d3-4d9b-a628-daadaf9bab75",
      "migrations_dir": "migrations"
    }
  ],
  // Evidencias (video o audio) que sube la app. Crear una vez: `npx wrangler r2 bucket create alerta-arrebato-evidencias`.
  "r2_buckets": [
    {
      "binding": "EVIDENCIAS",
      "bucket_name": "alerta-arrebato-evidencias"
    }
  ],
  // Número de WhatsApp (Meta Cloud API) que manda los avisos. No es secreto; el token sí:
  // `npx wrangler secret put META_WA_TOKEN`.
  // `ZAVU_LLAMADAS`: "si" = además del SMS, Zavu llama a cada contacto (agente "Alerta Arrebato" con voz en el sender).
  // `ORIGEN_ENLACES`: dominio de los enlaces de los SMS (Zavu rechaza *.workers.dev).
  // `ZAVU_SENDER_BLOQUEO`: sender "Cesar" de Zavu (+1 270 639 6180), otro número solo para el SMS de bloqueo al
  // vencer: Zavu deja 1 SMS por minuto por número y el de la detección sale ~25 s antes desde el número por defecto.
  // Notas de falsas alarmas (opcional, apagado por defecto): agregar `"ATOMIC_MEMORY_URL": "https://api.atomicstrata.ai"`
  // y `npx wrangler secret put ATOMIC_MEMORY_API_KEY`. Ver apps/api/README.md.
  "vars": {
    "META_WA_NUMERO_ID": "756647020860898",
    "ZAVU_LLAMADAS": "si",
    "ORIGEN_ENLACES": "https://alerta.gadidgc.com",
    "ZAVU_SENDER_BLOQUEO": "kd7eet1s1cvw0p8xzkyfp9pnzs8gcb7p"
  },
  // Dominio propio (de Gabriel) para los enlaces; workers.dev sigue activo porque la app lo usa.
  "routes": [{ "pattern": "alerta.gadidgc.com", "custom_domain": true }],
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
